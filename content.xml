uctureProperties><odePagStructureProperty><key>visibility</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>teacherOnly</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>allowToggle</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>minimized</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>identifier</key><value/></odePagStructureProperty><odePagStructureProperty><key>cssClass</key><value/></odePagStructureProperty></odePagStructureProperties><odeComponents><odeComponent><odePageId>20260502124927NNUVNI</odePageId><odeBlockId>20260502124927ZEQHKO</odeBlockId><odeIdeviceId>20260423122426224J8P</odeIdeviceId><odeIdeviceTypeName>text</odeIdeviceTypeName><htmlView>&lt;div class="exe-text-template"&gt;&lt;div class="textIdeviceContent"&gt;
            &lt;div class="exe-text-activity"&gt;
                &lt;div&gt;&lt;p&gt;Aprovechamos la salida a un entorno natural para posteriormente realizar esta actividad:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Se pedirá al alumnado que traigan materiales reciclados o de la naturaleza de pequeño tamaño, como tapones, envases, piedrecitas, ramas, hojas, etc.&lt;/li&gt;
&lt;li&gt;Harán un dibujo de un paisaje con río y montaña.&amp;nbsp;&lt;/li&gt;
&lt;li&gt;Cada cual, con ayuda de la maestra y de los compañeros y compañeras, realizará una maqueta sobre una base rígida, que puedan llevar a casa cuando se termine la actividad.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20260423122426224J8P/Maqueta_-_Escala.jpg" title="Escala de observación" width="622" height="571" alt=""&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p class="clearfix"&gt;&lt;/p&gt;&lt;/div&gt;
            &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;</htmlView><jsonProperties>{"ideviceId":"20260423122426224J8P","textInfoDurationInput":"","textInfoDurationTextInput":"Duración","textInfoParticipantsInput":"","textInfoParticipantsTextInput":"Agrupamiento","textTextarea":"&lt;p&gt;Aprovechamos la salida a un entorno natural para posteriormente realizar esta actividad:&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;Se pedirá al alumnado que traigan materiales reciclados o de la naturaleza de pequeño tamaño, como tapones, envases, piedrecitas, ramas, hojas, etc.&lt;/li&gt;\n&lt;li&gt;Harán un dibujo de un paisaje con río y montaña. &lt;/li&gt;\n&lt;li&gt;Cada cual, con ayuda de la maestra y de los compañeros y compañeras, realizará una maqueta sobre una base rígida, que puedan llevar a casa cuando se termine la actividad.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;&lt;img src=\"{{context_path}}/20260423122426224J8P/Maqueta_-_Escala.jpg\" title=\"Escala de observación\" width=\"622\" height=\"571\" alt=\"\" /&gt;&lt;/p&gt;\n&lt;p&gt;&lt;br /&gt;&lt;/p&gt;","textFeedbackInput":"Mostrar retroalimentación","textFeedbackTextarea":""}</jsonProperties><odeComponentsOrder>1</odeComponentsOrder><odeComponentsProperties><odeComponentsProperty><key>visibility</key><value>true</value></odeComponentsProperty><odeComponentsProperty><key>teacherOnly</key><value>false</value></odeComponentsProperty><odeComponentsProperty><key>identifier</key><value/></odeComponentsProperty><odeComponentsProperty><key>cssClass</key><value/></odeComponentsProperty></odeComponentsProperties></odeComponent></odeComponents></odePagStructure></odePagStructures></odeNavStructure><odeNavStructure><odePageId>20260502124927ILCZDX</odePageId><odeParentPageId>20260502124927XAYSFD</odeParentPageId><pageName>Infografía</pageName><odeNavStructureOrder>3</odeNavStructureOrder><odeNavStructureProperties><odeNavStructureProperty><key>titleNode</key><value/></odeNavStructureProperty><odeNavStructureProperty><key>hidePageTitle</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>titleHtml</key><value/></odeNavStructureProperty><odeNavStructureProperty><key>editableInPage</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>titlePage</key><value>Infografía</value></odeNavStructureProperty><odeNavStructureProperty><key>visibility</key><value>true</value></odeNavStructureProperty><odeNavStructureProperty><key>highlight</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>description</key><value/></odeNavStructureProperty></odeNavStructureProperties><odePagStructures><odePagStructure><odePageId>20260502124927ILCZDX</odePageId><odeBlockId>20260502124927UYGQEW</odeBlockId><blockName>La huella contaminante</blockName><iconName>icon_arts</iconName><odePagStructureOrder>1</odePagStructureOrder><odePagStructureProperties><odePagStructureProperty><key>visibility</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>teacherOnly</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>allowToggle</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>minimized</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>identifier</key><value/></odePagStructureProperty><odePagStructureProperty><key>cssClass</key><value/></odePagStructureProperty></odePagStructureProperties><odeComponents><odeComponent><odePageId>20260502124927ILCZDX</odePageId><odeBlockId>20260502124927UYGQEW</odeBlockId><odeIdeviceId>20260423122448061BT4</odeIdeviceId><odeIdeviceTypeName>text</odeIdeviceTypeName><htmlView>&lt;div class="exe-text-template"&gt;&lt;div class="textIdeviceContent"&gt;
            &lt;div class="exe-text-activity"&gt;
                &lt;div&gt;&lt;p&gt;Los plásticos contaminan las costas y los ríos, afectando a toda la fauna acuática. Los animales se enredan en ellos y confunden los fragmentos más pequeños con comida, lo que puede provocar su intoxicación y acabar con su vida. Los seres humanos, debido a la cadena alimentaria, también ingieren este material, aunque las consecuencias para su salud aún no están determinadas.&lt;/p&gt;
&lt;div class="exe-fx exe-accordion"&gt;
&lt;h2&gt;Materiales&lt;/h2&gt;
&lt;p&gt;&lt;span style="background-color: #ffffff;"&gt;Se pide al alumnado, con implicación de las familias, que traigan al aula objetos/plásticos que alguna vez han observado en el agua del río o en el mar.&lt;/span&gt;&lt;/p&gt;
&lt;h2&gt;Creación&lt;/h2&gt;
&lt;p&gt;C&lt;span style="background-color: #ffffff;"&gt;rearemos una infografía con la silueta de una huella de un pie.&amp;nbsp;&lt;/span&gt;&lt;span style="background-color: #ffffff;"&gt;Investigaremos cuánto tardan en desaparecer en la naturaleza los materiales que vamos a utilizar, para ello utilizaremos la&amp;nbsp;&lt;/span&gt;&lt;a href="#t6467bd2d-7d95-0d2a-874f-db6436f2aedb" id="link6467bd2d-7d95-0d2a-874f-db6436f2aedb" class="exe-tooltip definition-tt titled-tt green-tt rounded-tt shadowed-tt" title="PDI | " style="color: #0d6efd; background-color: #ffffff;"&gt;PDI&lt;/a&gt;&lt;span style="background-color: #ffffff;"&gt;. &lt;/span&gt;&lt;span style="background-color: #ffffff;"&gt;Los niños/as de manera visual entenderán que es una huella negativa.&lt;/span&gt;&lt;/p&gt;
&lt;h2&gt;&lt;span style="background-color: #000000;"&gt;Resultado&lt;/span&gt;&lt;/h2&gt;
&lt;p&gt;&lt;span style="background-color: #000000;"&gt;&lt;span style="background-color: #ffffff;"&gt;Acabaremos la actividad, mediante la rutina de pensamiento Veo, pienso, me pregunto.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Veo: hay muchos plástico en el agua.&lt;/li&gt;
&lt;li&gt;Pienso: las personas no estamos cuidado el agua.&lt;/li&gt;
&lt;li&gt;Me pregunto: &amp;nbsp;¿Qué podemos hacer para mejorar esta situación?&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20260423122448061BT4/Veo_pienso_pregunto.jpg" title="Ver, pensar, preguntar" width="510" height="281" alt="" style="background-color: #ffffff; display: block; margin-left: auto; margin-right: auto;"&gt;&lt;/p&gt;
&lt;h2&gt;Evaluación&lt;/h2&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20260423122448061BT4/Infografa_-_Rbrica.jpg" title="Rúbrica docente" width="713" height="871" alt="" style="display: block; margin-left: auto; margin-right: auto;"&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;div id="t6467bd2d-7d95-0d2a-874f-db6436f2aedb" class="exe-tooltip-text"&gt;
&lt;p&gt;Pizarra Digital Interactiva&lt;/p&gt;
&lt;/div&gt;&lt;p class="clearfix"&gt;&lt;/p&gt;&lt;/div&gt;
            &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;</htmlView><jsonProperties>{"ideviceId":"20260423122448061BT4","textInfoDurationInput":"","textInfoDurationTextInput":"Duración","textInfoParticipantsInput":"","textInfoParticipantsTextInput":"Agrupamiento","textTextarea":"&lt;p&gt;Los plásticos contaminan las costas y los ríos, afectando a toda la fauna acuática. Los animales se enredan en ellos y confunden los fragmentos más pequeños con comida, lo que puede provocar su intoxicación y acabar con su vida. Los seres humanos, debido a la cadena alimentaria, también ingieren este material, aunque las consecuencias para su salud aún no están determinadas.&lt;/p&gt;\n&lt;div class=\"exe-fx exe-accordion\"&gt;\n&lt;h2&gt;Materiales&lt;/h2&gt;\n&lt;p&gt;&lt;span style=\"background-color: #ffffff;\"&gt;Se pide al alumnado, con implicación de las familias, que traigan al aula objetos/plásticos que alguna vez han observado en el agua del río o en el mar.&lt;/span&gt;&lt;/p&gt;\n&lt;h2&gt;Creación&lt;/h2&gt;\n&lt;p&gt;C&lt;span style=\"background-color: #ffffff;\"&gt;rearemos una infografía con la silueta de una huella de un pie. &lt;/span&gt;&lt;span style=\"background-color: #ffffff;\"&gt;Investigaremos cuánto tardan en desaparecer en la naturaleza los materiales que vamos a utilizar, para ello utilizaremos la &lt;/span&gt;&lt;a href=\"#t6467bd2d-7d95-0d2a-874f-db6436f2aedb\" id=\"link6467bd2d-7d95-0d2a-874f-db6436f2aedb\" class=\"exe-tooltip definition-tt titled-tt green-tt rounded-tt shadowed-tt\" title=\"PDI | \" style=\"color: #0d6efd; background-color: #ffffff;\"&gt;PDI&lt;/a&gt;&lt;span style=\"background-color: #ffffff;\"&gt;. &lt;/span&gt;&lt;span style=\"background-color: #ffffff;\"&gt;Los niños/as de manera visual entenderán que es una huella negativa.&lt;/span&gt;&lt;/p&gt;\n&lt;h2&gt;&lt;span style=\"background-color: #000000;\"&gt;Resultado&lt;/span&gt;&lt;/h2&gt;\n&lt;p&gt;&lt;span style=\"background-color: #000000;\"&gt;&lt;span style=\"background-color: #ffffff;\"&gt;Acabaremos la actividad, mediante la rutina de pensamiento Veo, pienso, me pregunto.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;Veo: hay muchos plástico en el agua.&lt;/li&gt;\n&lt;li&gt;Pienso: las personas no estamos cuidado el agua.&lt;/li&gt;\n&lt;li&gt;Me pregunto:  ¿Qué podemos hacer para mejorar esta situación?&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;&lt;img src=\"{{context_path}}/20260423122448061BT4/Veo_pienso_pregunto.jpg\" title=\"Ver, pensar, preguntar\" width=\"510\" height=\"281\" alt=\"\" style=\"background-color: #ffffff; display: block; margin-left: auto; margin-right: auto;\" /&gt;&lt;/p&gt;\n&lt;h2&gt;Evaluación&lt;/h2&gt;\n&lt;p&gt;&lt;img src=\"{{context_path}}/20260423122448061BT4/Infografa_-_Rbrica.jpg\" title=\"Rúbrica docente\" width=\"713\" height=\"871\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\" /&gt;&lt;/p&gt;\n&lt;/div&gt;\n&lt;p&gt;&lt;br /&gt;&lt;/p&gt;\n&lt;div id=\"t6467bd2d-7d95-0d2a-874f-db6436f2aedb\" class=\"exe-tooltip-text\"&gt;\n&lt;p&gt;Pizarra Digital Interactiva&lt;/p&gt;\n&lt;/div&gt;","textFeedbackInput":"Mostrar retroalimentación","textFeedbackTextarea":""}</jsonProperties><odeComponentsOrder>1</odeComponentsOrder><odeComponentsProperties><odeComponentsProperty><key>visibility</key><value>true</value></odeComponentsProperty><odeComponentsProperty><key>teacherOnly</key><value>false</value></odeComponentsProperty><odeComponentsProperty><key>identifier</key><value/></odeComponentsProperty><odeComponentsProperty><key>cssClass</key><value/></odeComponentsProperty></odeComponentsProperties></odeComponent></odeComponents></odePagStructure></odePagStructures></odeNavStructure></odeNavStructures></ode>
